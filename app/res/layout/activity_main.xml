<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="路线模拟器（标准显式 mock 定位）"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="仅创建系统 gps 测试位置，系统会标记 mock；不会隐藏标记。不会启动或提交悦跑世界成绩。"
            android:textColor="#B00020"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnImportGpx"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导入 GPX" />

            <Button
                android:id="@+id/btnImportJson"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导入 JSON" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEditRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="编辑经纬度途经点（无地图）" />

        <TextView
            android:id="@+id/tvRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:text="尚未导入路线。支持多条共起终点的闭合环；WGS84，顺序为 lat,lon。"
            android:textSize="12sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="步频增强目标包名（可选；需已 LSPatch 改包并运行）" android:textSize="12sp" />
        <EditText
            android:id="@+id/etTargetPkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:text="com.joyrunworld.app" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="最快配速(秒/公里, 180–600)" android:textSize="12sp" />
                <EditText
                    android:id="@+id/etFast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="390" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="最慢配速(秒/公里, 180–600)" android:textSize="12sp" />
                <EditText
                    android:id="@+id/etSlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="470" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="总距离(米, 有限正数)" android:textSize="12sp" />
                <EditText
                    android:id="@+id/etDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="2000" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="位置扰动上限(米, 0–0.5)" android:textSize="12sp" />
                <EditText
                    android:id="@+id/etLateral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="0.3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="程序模拟步频下限(1–300 spm)" android:textSize="12sp" />
                <EditText
                    android:id="@+id/etCadenceMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="100" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="程序模拟步频上限(1–300 spm)" android:textSize="12sp" />
                <EditText
                    android:id="@+id/etCadenceMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="130" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="配速可选 180–600 秒/公里（3:00–10:00），默认 390/470；总距离为有限正数；步频上下限 1–300 spm，默认 100/130，要求下限≤上限。步频程序模拟值仅本机显示；只有目标 App 已用 LSPatch 改包并在运行，才会通过本机回环桥接读取增强步频。未改包的目标 App 仍读真实传感器。"
            android:textColor="#B00020"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始（标准 mock 定位）" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="停止并清理" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="暂停并保存断点" />

            <Button
                android:id="@+id/btnResume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="继续断点" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#E8F5E9"
            android:padding="8dp"
            android:text="状态：空闲"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="距离 0 / 0 m\n模拟配速 —（非目标应用读数）\n程序模拟步频 —（增强需改包）\n路线 —  注入次数 0\n坐标 —  (WGS84)\n断点 无  步频桥 未启用"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="运行日志"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:fontFamily="monospace"
            android:minLines="6"
            android:padding="6dp"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="限制与边界：\n• 使用 Android 标准 LocationManager 测试提供器，系统会显示 mock 标记。\n• 公开 API 无法枚举其他应用的测试提供器；启动前仅检查最近位置 mock 标记，冲突时中止。\n• 只移除本应用成功创建的 gps 提供器；清理失败会显示“清理失败”，不再报完成。\n• 程序步频仅本机显示；目标 App 必须已改包并运行才可能读到增强步频，未改包时仍读真实传感器。\n• 不 root、不隐藏 mock、不自动提交成绩。\n• P2 当前切片支持单条开放折线（端点原路折返）或共享交点闭环；随机路网、必经打卡点/顺序、随机起终点待后续。\n• 目标应用可能根据连续定位点自行计算速度；本工具不注入 speed 字段。"
            android:textColor="#444444"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
